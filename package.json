{
  "name": "alexander-domanov-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website built with vanilla HTML, CSS, SCSS, and JavaScript",
  "keywords": [
    "portfolio",
    "html",
    "css",
    "scss",
    "javascript",
    "vanilla-js"
  ],
  "author": "Alexander Domanov <alexanderdomanov.dev@gmail.com>",
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "htmlhint": "^1.8.0",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sass": "^1.90.0",
    "vite": "^8.2.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-scss": "^6.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:js": "eslint . --ext .js",
    "check:styles": "stylelint 'scss/**/*.scss'",
    "check:html": "htmlhint '**/*.html' --ignore 'dist/**' --format unix",
    "check:format": "prettier --check \"*.{js,json,md,html}\" \"scss/**/*.scss\"",
    "check": "npm run check:js && npm run check:styles && npm run check:html && npm run check:format",
    "fix:js": "eslint . --ext .js --fix",
    "fix:styles": "stylelint 'scss/**/*.scss' --fix",
    "fix:format": "prettier --write \"*.{js,json,md,html}\" \"scss/**/*.scss\"",
    "fix": "npm run fix:js && npm run fix:styles && npm run fix:format",
    "test": "echo \"No tests yet\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix",
    "*.{css,scss}": "stylelint --fix",
    "*.{js,jsx,ts,tsx,css,scss,html,json,md}": "prettier --write"
  }
}
